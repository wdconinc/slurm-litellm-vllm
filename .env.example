# Security
# This key protects your LiteLLM Proxy from unauthorized access on the HPC cluster.
# Any client connecting to the proxy must provide this key as their API Key.
LITELLM_MASTER_KEY="sk-hpc-secret-key"

# Hugging Face
# If you are downloading gated models (like Llama-3), you must provide your Hugging Face access token.
# HF_TOKEN="hf_your_access_token_here"

# (Optional) Observability (Langfuse)
# If provided, LiteLLM will log all requests and metrics to Langfuse.
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_HOST="https://cloud.langfuse.com"

# (Optional) Overrides
# VLLM_CACHE_ROOT="/project/1234567/vllm_cache"
# HF_HOME="/project/1234567/huggingface_cache"
